        <mxCell id="cell455" value="DRAFT EXECUTION RULES&lt;br&gt;During draft-cache initialization: cache only, no candidates.&lt;br&gt;On later decode calls: 3 stages calculate candidate representations.&lt;br&gt;The external scheduler handles acceptance/rejection." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fillColor=#FFF4DE;strokeColor=#D09A3E;strokeWidth=2;fontColor=#17304C;fontFamily=Arial;fontSize=21;fontStyle=0;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="155" y="10219" width="740" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="cell456" value="DRAFT EXPERTS&lt;br&gt;3 routed experts + 1 shared expert per draft stage&lt;br&gt;Separate from backbone: 6 routed + 1 shared" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fillColor=#FFF1E1;strokeColor=#B9783C;strokeWidth=2;fontColor=#17304C;fontFamily=Arial;fontSize=20;fontStyle=0;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="2080" y="10637" width="740" height="141" as="geometry"/>
        </mxCell>
        <mxCell id="cell457" value="&lt;b&gt;READING NOTES / VERIFIED SCOPE&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fillColor=#183A5E;strokeColor=#183A5E;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=25;fontStyle=1;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="150" y="11290" width="2680" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="cell458" value="Backbone = 40 sequential layers. Encoder and Decoder are contiguous phases of one model, not two separately invoked networks.&lt;br&gt;Every backbone layer has its own Query and local causal window. Shared compressed KV is refreshed only at L2 / L8 / L14 / L20.&lt;br&gt;Top-k is refreshed at L2 / L8 / L14 / L20 / L24 / L28 / L32 / L36. Engram modifies the 4 streams before L1 and L14.&lt;br&gt;Draft 40–42 are explicitly shown downstream as the complete speculative path, but must be invoked separately by orchestration.&lt;br&gt;Diagram simplifies implementation-level quantization and communications; it does not claim to describe training backward kernels." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fillColor=#FFFFFF;strokeColor=#AFBCCB;strokeWidth=2;fontColor=#17304C;fontFamily=Arial;fontSize=18;fontStyle=0;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="190" y="11372" width="2600" height="119" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
