node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
src/compute_lab/qa/chrome-profile/
src/compute_lab/qa/diagnostic-profile/
*.log
.DS_Store
~$*

# QA/test screenshots are regenerated by the Playwright verify_*.{cjs,mjs} scripts and
# shouldn't be committed. Scoped to qa/ paths, not a blanket *.png, so real content
# images (docs/assets/, references/deepseek/) stay trackable.
src/compute_lab/qa/*.png
src/deepseek/qa/**/*.png
# ...except reference.png, a supplied input fixture that verify_browser.cjs reads
# from (not a generated screenshot) for its side-by-side comparison check.
!src/deepseek/qa/reference.png
